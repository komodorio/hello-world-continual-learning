# Copy to .env (git-ignored). Set the key for every provider used under `models:` in config.yaml;
# the provider is the prefix of the model string (anthropic/..., baseten/..., openrouter/...).
# An exported shell variable of the same name takes precedence over this file.

# Required with the default config.yaml (all four roles on Anthropic models).
ANTHROPIC_API_KEY=

# Only if you point a role at that provider, e.g. student: baseten/moonshotai/Kimi-K2.5
# BASETEN_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
