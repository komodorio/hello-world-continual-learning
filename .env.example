# Copy to .env (git-ignored). Set the key for every provider used under `models:` in config.yaml;
# the provider is the prefix of the model string (anthropic/..., bedrock/..., baseten/..., openrouter/...).
# An exported shell variable of the same name takes precedence over this file.

# Required with the default config.yaml (all four roles on Anthropic models).
ANTHROPIC_API_KEY=

# Only if you point a role at that provider, e.g. student: baseten/moonshotai/Kimi-K2.5
# BASETEN_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# Only if a role uses bedrock/... . There is no API key: LiteLLM uses the boto3 credential chain,
# but the region must be set here — it is not read from ~/.aws/config.
# AWS_REGION_NAME=us-east-1
# AWS_PROFILE=my-sso-profile
